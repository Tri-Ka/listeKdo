# Copier en deploy.env (jamais dans git) puis adapter.

# Connexion SSH à la VM de la Freebox : utilisateur@IP locale de la VM
KDO_SSH=freebox@192.168.1.29

# Nom de domaine du site, qui doit pointer vers l'IP publique de la Freebox.
# Certificat HTTPS automatique (Let's Encrypt) ; le site est servi sur https://<KDO_DOMAIN>/listeKdo/.
# Sans domaine à soi : le nom de la Freebox, <xxxxxxxx>.fbxos.fr (api_domain de http://mafreebox.freebox.fr/api_version).
KDO_DOMAIN=ab12cd34.fbxos.fr

# E-mails (mot de passe oublié) : compte Gmail avec validation en deux étapes, et mot de passe
# d'application créé dans Compte Google → Sécurité → Mots de passe des applications. Vides = pas d'envoi.
SMTP_USER=
SMTP_PASSWORD=

# Dossier du site dans le répertoire personnel de la VM
KDO_REMOTE_DIR=listekdo
